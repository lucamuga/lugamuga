function nm(s){return(s||"").toLowerCase().replace(/ä/g,"ae").replace(/ö/g,"oe").replace(/ü/g,"ue").replace(/ß/g,"ss");}
function mt(d){
  if(!d.lat||!d.lng)return false;
  if(fG.length>0){var gwt=d.gw||"";var match=fG.some(function(g){return nm(gwt).indexOf(nm(g))>=0;});if(!match)return false;}
  if(fS.length>0&&fS.indexOf(d.st||"")<0)return false;
  if(fY.length>0&&fY.indexOf(String(d.jr))<0)return false;
  if(fQ.length>0){
    var plname=PL[d.pl||""]?PL[d.pl].name:"";
    var sbname=d.sb?d.sb.name:"";
    var haystack=nm([d.name,String(d.nr),d.ag,d.stadt,d.adr,d.gw,d.desc,String(d.jr),plname,sbname].join(" "));
    var needles=nm(fQ).split(/\s+/).filter(function(t){return t.length>0;});
    for(var i=0;i<needles.length;i++){if(haystack.indexOf(needles[i])<0)return false;}
  }
  return true;
}

