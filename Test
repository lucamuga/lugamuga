  kinoFillPL(d);
  if(d.lat&&d.lng&&kinoMap){
    // Alle Pins auf Kino-Karte zeichnen
    if(window._kinoMarkers){window._kinoMarkers.forEach(function(m){m.remove();});}
    window._kinoMarkers=[];
    var kList=currentList.length>0?currentList:DATA;
    kList.forEach(function(proj){
      if(!proj.lat||!proj.lng)return;
      var el=document.createElement("div");
      el.style.cssText="width:22px;height:22px;border-radius:50% 50% 50% 0;transform:rotate(-45deg);border:2px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,.3);background:"+(SCOL[proj.st||""]||"#6b7280");
      if(proj===d)el.classList.add("kino-pin-active");
      var mk=new mapboxgl.Marker({element:el,anchor:"center"}).setLngLat([proj.lng,proj.lat]).addTo(kinoMap);
      window._kinoMarkers.push(mk);
    });
    var doFly=function(){
      // Schritt 1: Rauszoomen auf Deutschland
      kinoMap.flyTo({center:[10.45,51.16],zoom:5.2,speed:1.0,curve:1.2,essential:true});
      kinoMap.once("moveend",function(){
        if(kinoPaused)return;
        // Schritt 2: Reinzoomen auf das Projekt
        setTimeout(function(){
          if(kinoPaused)return;
          kinoMap.flyTo({center:[d.lng,d.lat],zoom:15,speed:0.8,curve:1.6,essential:true});
          kinoMap.once("moveend",function(){
            if(kinoPaused)return;
            // Schritt 3: 2 Sekunden stehen bleiben
            clearTimeout(kinoTimer);
            kinoTimer=setTimeout(function(){
              var list=currentList.length>0?currentList:DATA;
              kinoIdx=(kinoIdx+1)%list.length;
              kinoShow(list[kinoIdx]);
            },2000);
          });
        },400);
      });
    };
    if(kinoMap.loaded()){doFly();}
    else{kinoMap.once("load",doFly);}
  }

}

