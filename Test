    kinoMap=new mapboxgl.Map({container:"kino-map",style:cst==="satellite"?"mapbox://styles/mapbox/satellite-streets-v12":"mapbox://styles/mapbox/light-v11",center:[10.45,51.16],zoom:5.2,interactive:false,attributionControl:false});
  } else {
    kinoMap.setStyle(cst==="satellite"?"mapbox://styles/mapbox/satellite-streets-v12":"mapbox://styles/mapbox/light-v11");
  }
  kinoShow(list[kinoIdx]);
  kinoTick();
}

// Manuell zu Projekt springen - zeigt es, wartet 2s, macht dann automatisch weiter
var _kinoBusy=false;
function kinoJumpTo(d){
  clearTimeout(kinoTimer);
  _kinoBusy=true;
  kinoMap.off("moveend"); // alle alten moveend-Listener entfernen
  // Info sofort befüllen
  var list=currentList.length>0?currentList:DATA;
  var idx=list.indexOf(d);
  document.getElementById("kino-count").textContent=(idx+1)+" / "+list.length;
  var tags='<span class="sbg '+(SBCL[d.st||""]||"sb-d")+'">'+(SBLB[d.st||""])+'</span>';
  if(d.gw)tags+='<span class="gtg">'+d.gw+'</span>';
  if(d.jr)tags+='<span class="jtg">'+d.jr+'</span>';
  document.getElementById("ki-tags").innerHTML=tags;
  document.getElementById("ki-title").textContent=d.name;
  document.getElementById("ki-loc").textContent=d.adr||d.stadt;
  document.getElementById("ki-nr").textContent=d.nr;
  document.getElementById("ki-ag").textContent=d.ag||"-";document.getElementById("ki-gw").textContent=d.gw||"-";
  document.getElementById("ki-desc").textContent=d.desc||"";
  var kiA2=document.getElementById("ki-anlagen"),kiAL2=document.getElementById("ki-anlagen-list");
  if(d.anlagen&&d.anlagen.trim()){kiAL2.innerHTML=d.anlagen.split("\n").map(function(s){return "<li>"+s.trim()+"</li>";}).filter(Boolean).join("");kiA2.style.display="block";}else{kiA2.style.display="none";}
  kinoFillPL(d);
  // Marker neu setzen
  if(window._kinoMarkers){window._kinoMarkers.forEach(function(m){m.remove();});}
  window._kinoMarkers=[];
  var kList=currentList.length>0?currentList:DATA;
  kList.forEach(function(proj){if(!proj.lat||!proj.lng)return;var el=document.createElement("div");el.style.cssText="width:22px;height:22px;border-radius:50% 50% 50% 0;transform:rotate(-45deg);border:2px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,.3);background:"+(SCOL[proj.st||""]||"#999999");if(proj===d)el.classList.add("kino-pin-active");var mk=new mapboxgl.Marker({element:el,anchor:"center"}).setLngLat([proj.lng,proj.lat]).addTo(kinoMap);window._kinoMarkers.push(mk);});
  if(d.lat&&d.lng){
    // Direkt auf das Projekt einzoomen (kein Raus-Zoom beim manuellen Sprung)
    kinoMap.off("moveend");
    kinoMap.flyTo({center:[d.lng,d.lat],zoom:15,speed:1.2,curve:1.4,essential:true});
    kinoMap.once("moveend",function(){
      _kinoBusy=false;
      kinoHighlightList(kinoIdx);
      if(kinoPaused)return;
      // 2 Sekunden anzeigen, dann automatisch weiter
      clearTimeout(kinoTimer);
      kinoTimer=setTimeout(function(){
        if(kinoPaused||!kinoRunning)return;
        var list2=currentList.length>0?currentList:DATA;
        kinoIdx=(kinoIdx+1)%list2.length;
        kinoShow(list2[kinoIdx]);
      },2000);
    });
  }
}

function kinoStop(){clearTimeout(kinoTimer);kinoRunning=false;kinoPaused=false;_kinoBusy=false;if(kinoMap)kinoMap.off("moveend");document.getElementById("kino-overlay").classList.remove("show");document.getElementById("kino-btn").classList.remove("running");document.getElementById("kino-btn").innerHTML="&#127916; Kino";}

document.getElementById("kino-btn").onclick=function(){if(kinoRunning){kinoStop();}else{kinoStart();}};
document.getElementById("kino-close").onclick=kinoStop;
document.getElementById("kino-next").onclick=function(){clearTimeout(kinoTimer);var list=currentList.length>0?currentList:DATA;kinoIdx=(kinoIdx+1)%list.length;kinoShow(list[kinoIdx]);kinoTick();};
document.getElementById("kino-prev").onclick=function(){clearTimeout(kinoTimer);var list=currentList.length>0?currentList:DATA;kinoIdx=(kinoIdx-1+list.length)%list.length;kinoShow(list[kinoIdx]);kinoTick();};
document.addEventListener("keydown",function(e){if(!kinoRunning)return;if(e.key==="Escape")kinoStop();});
</script>
