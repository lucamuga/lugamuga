  document.getElementById("ki-tags").innerHTML=tags;
  document.getElementById("ki-title").textContent=d.name;
  document.getElementById("ki-loc").textContent=d.adr||d.stadt;
  document.getElementById("ki-nr").textContent=d.nr;
  document.getElementById("ki-ag").textContent=d.ag||"-";
  document.getElementById("ki-gw").textContent=d.gw||"-";
  document.getElementById("ki-desc").textContent=d.desc||"";
  var kiA=document.getElementById("ki-anlagen"),kiAL=document.getElementById("ki-anlagen-list");
