// ── Cluster-Erkennung: gruppiert Projekte mit gleicher Adresse oder gleichen Koordinaten ──
function buildClusters(list){
  var clusters=[];
  var used=[];
  list.forEach(function(d,i){
    if(used.indexOf(i)>=0)return;
    var grp=[d];
    used.push(i);
    list.forEach(function(d2,j){
      if(j<=i||used.indexOf(j)>=0)return;
      var sameAdr=(d.adr&&d2.adr&&d.adr.trim()===d2.adr.trim());
      var sameLng=(d.lat&&d.lng&&d2.lat&&d2.lng&&d.lat===d2.lat&&d.lng===d2.lng);
      if(sameAdr||sameLng){grp.push(d2);used.push(j);}
    });
    clusters.push(grp);
  });
  return clusters;
}

