<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>airpool Projektkarte</title>
<link href="https://api.mapbox.com/mapbox-gl-js/v3.6.0/mapbox-gl.css" rel="stylesheet">
<script src="https://api.mapbox.com/mapbox-gl-js/v3.6.0/mapbox-gl.js"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#f4f6f9;color:#111}
.wrap{max-width:1480px;margin:0 auto;padding:24px 20px}
.hdr{display:flex;align-items:flex-end;gap:12px;margin-bottom:16px;flex-wrap:wrap}
.logo{font-size:24px;font-weight:800;color:#00234b;letter-spacing:-0.5px;white-space:nowrap}
.logo span{color:#e41e26}
.sb{position:relative;flex:1;min-width:180px;max-width:300px}
.sb input{width:100%;padding:8px 28px 8px 32px;font-size:14px;border:1.5px solid #e5e7eb;border-radius:10px;background:#f8f9fb;font-family:inherit;outline:none;color:#111;transition:all .15s}
.sb input:focus{border-color:#00234b;background:#fff}
.sb input::placeholder{color:#9ca3af}
.sb .si{position:absolute;left:10px;top:50%;transform:translateY(-50%);color:#9ca3af;font-size:14px;pointer-events:none}
.sb .scl{position:absolute;right:8px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:#9ca3af;font-size:15px;display:none}
.dds{display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end}
.dw{position:relative;display:flex;flex-direction:column;gap:3px}
.dw-label{font-size:11px;font-weight:600;color:#6b7280;letter-spacing:.02em}
.dw-btn{padding:7px 26px 7px 11px;font-size:13px;border:1.5px solid #e5e7eb;border-radius:10px;background:#fff;font-family:inherit;cursor:pointer;outline:none;color:#374151;font-weight:500;min-width:105px;transition:all .15s;text-align:left;white-space:nowrap;position:relative}
.dw-btn:focus{border-color:#00234b}
.dw-btn.on{background:#00234b;color:#fff;border-color:#00234b}
.dw-btn.on .da{color:#fff}
.dw .da{position:absolute;right:8px;top:50%;transform:translateY(-50%);pointer-events:none;font-size:10px;color:#6b7280}
.ms-drop{position:absolute;top:calc(100% + 4px);left:0;min-width:160px;background:#fff;border:1.5px solid #e5e7eb;border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,.12);z-index:500;display:none;padding:6px}
.ms-drop.open{display:block}
.ms-item{display:flex;align-items:center;gap:8px;padding:6px 8px;border-radius:8px;cursor:pointer;font-size:13px;color:#374151;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;transition:background .1s}
.ms-item:hover{background:#f0f4ff}
.ms-item input[type=checkbox]{accent-color:#00234b;width:14px;height:14px;cursor:pointer;flex-shrink:0}
.ms-clear{width:100%;margin-top:4px;padding:5px;background:#f8f9fb;border:1px solid #e5e7eb;border-radius:7px;font-size:11px;font-weight:600;color:#6b7280;cursor:pointer;font-family:inherit}
.ms-clear:hover{background:#eef2ff;color:#00234b}
.hdr-r{display:flex;gap:8px;margin-left:auto;align-items:flex-end}
.abtn{padding:8px 14px;border-radius:10px;border:1.5px solid #e5e7eb;background:#fff;cursor:pointer;font-family:inherit;font-size:13px;font-weight:600;color:#6b7280;transition:all .15s}
.abtn:hover{border-color:#ccc;color:#111}
.abtn.on{background:#00234b;color:#fff;border-color:#00234b}
.kino-btn{position:absolute;top:10px;right:12px;z-index:200;padding:6px 12px;border-radius:10px;border:1.5px solid rgba(255,255,255,.9);background:rgba(255,255,255,.92);cursor:pointer;font-family:inherit;font-size:13px;font-weight:600;color:#374151;box-shadow:0 2px 6px rgba(0,0,0,.18);white-space:nowrap;transition:all .15s}
.kino-btn:hover{border-color:#dc0a2d;color:#dc0a2d;background:#fff}
.kino-btn.running{background:#dc0a2d;color:#fff;border-color:#dc0a2d;box-shadow:0 2px 8px rgba(220,10,45,.35)}
.grid{display:grid;grid-template-columns:300px 1fr;gap:16px;align-items:start}
.sidebar{background:#fff;border:1.5px solid #e5e7eb;border-radius:16px;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,.05);height:620px;display:flex;flex-direction:column}
.sh{padding:14px 16px 10px;border-bottom:1px solid #f3f4f6}
.sh h3{font-size:14px;font-weight:700;color:#00234b}
.shc{font-size:12px;color:#6b7280;margin-top:2px}
.pl{flex:1;overflow-y:auto;padding:8px;min-height:0}
.pl::-webkit-scrollbar{width:4px}
.pl::-webkit-scrollbar-thumb{background:#e5e7eb;border-radius:4px}
.pi{padding:10px 12px;border-radius:10px;cursor:pointer;border:1.5px solid transparent;margin-bottom:4px;transition:all .12s}
.pi:hover{background:#f8f9fb}
.pi.act{background:#f0f4ff;border-color:#c7d2fe}
.pi-n{font-size:13px;font-weight:600;color:#111;line-height:1.35;margin-bottom:5px}
.pi-m{display:flex;gap:5px;flex-wrap:wrap;align-items:center}
.pk{padding:3px 8px;border-radius:100px;font-size:11px;font-weight:700}
.k-b{background:#fee2e2;color:#dc0a2d}
.k-a{background:#dcfce7;color:#15803d}
.k-p{background:#dce8f5;color:#00234b}
.k-d{background:#f2f2f2;color:#6b7280}
.pi-c{font-size:11px;color:#9ca3af}
.ss{padding:12px 14px;border-top:1px solid #f3f4f6;display:grid;grid-template-columns:1fr 1fr;gap:8px}
.sc3{background:#f8f9fb;border-radius:9px;padding:9px 10px;text-align:center}
.sn{font-size:20px;font-weight:700;color:#00234b}
.sl{font-size:11px;color:#6b7280;margin-top:2px}
.mapbox{border-radius:16px;overflow:visible;position:relative;border:1.5px solid #e5e7eb;box-shadow:0 2px 12px rgba(0,0,0,.06);flex:1;min-width:0;height:620px}
#map{width:100%;height:100%;border-radius:14px;overflow:hidden}
.stog{position:absolute;bottom:28px;left:10px;z-index:200;display:flex;flex-direction:column;gap:4px}
.stbtn{padding:5px 10px;font-size:12px;font-weight:600;border-radius:8px;border:1.5px solid rgba(255,255,255,.9);background:rgba(255,255,255,.92);cursor:pointer;font-family:inherit;color:#374151;box-shadow:0 1px 4px rgba(0,0,0,.12);white-space:nowrap}
.stbtn.on{background:#00234b;color:#fff;border-color:#00234b}
.abn{position:absolute;top:10px;right:12px;max-width:300px;background:#00234b;color:#fff;border-radius:10px;padding:9px 13px;font-size:13px;display:none;align-items:center;gap:8px;z-index:200}
.abn.show{display:flex}
.pin{width:16px;height:16px;border-radius:50%;border:2px solid #fff;cursor:pointer;box-shadow:0 2px 6px rgba(0,0,0,.28)}
.pin:hover{box-shadow:0 3px 10px rgba(0,0,0,.4)}
.pin.act{outline:3px solid rgba(180,180,180,.6);outline-offset:2px}
@keyframes kino-pulse{0%{box-shadow:0 0 0 0 rgba(255,255,255,.7),0 2px 6px rgba(0,0,0,.3)}70%{box-shadow:0 0 0 10px rgba(255,255,255,0),0 2px 6px rgba(0,0,0,.3)}100%{box-shadow:0 0 0 0 rgba(255,255,255,0),0 2px 6px rgba(0,0,0,.3)}}
.kino-pin-active{animation:kino-pulse 1.4s ease-out infinite;outline:3px solid rgba(255,255,255,.9)!important;outline-offset:3px}
.pin.drg{cursor:grab}
.pin.drg.dragging{cursor:grabbing}

/* Panel als rechte Spalte */
.map-panel-wrap{display:flex;gap:16px;align-items:flex-start;position:relative}
.panel-wrap{display:none;flex-direction:column;gap:0;width:300px;flex-shrink:0;position:relative;margin-top:-44px}
.panel-wrap.show{display:flex}
.pnav-row{display:flex;align-items:center;padding:0 2px;height:44px;flex-shrink:0;gap:6px;position:relative}
.pnav-btn{width:36px;height:36px;border-radius:50%;background:#fff;border:1.5px solid #e5e7eb;cursor:pointer;font-family:inherit;color:#374151;font-size:20px;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(0,0,0,.1);transition:all .15s;flex-shrink:0;line-height:1}
.pnav-btn:hover{background:#f0f4ff;border-color:#c7d2fe;color:#00234b}
.pnav-btn:disabled{opacity:.28;cursor:default;pointer-events:none}
.pnav-info{font-size:11px;color:#6b7280;font-weight:500;white-space:nowrap;flex:1;text-align:center}
.panel{background:#fff;border:1.5px solid #e5e7eb;border-radius:16px;box-shadow:0 2px 12px rgba(0,0,0,.06);overflow-y:auto;flex:1;min-height:0}
.pim{width:100%;background:linear-gradient(135deg,#dce8f5,#e8f0fe);display:flex;align-items:center;justify-content:center;height:90px;color:#9ca3af;font-size:14px;border-radius:14px 14px 0 0;overflow:hidden}
.pim.has{height:200px}
.pim img{width:100%;height:100%;object-fit:cover}
.pb{padding:18px}
.pcls{background:#fff;border:1.5px solid #e5e7eb;cursor:pointer;color:#6b7280;font-size:13px;width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 1px 4px rgba(0,0,0,.1);font-family:inherit;transition:all .15s;position:absolute;top:-32px;right:0}
.pcls:hover{color:#dc0a2d;border-color:#dc0a2d;background:#fff8f8}
.tgs{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:10px}
.sbg{padding:4px 10px;border-radius:100px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.03em}
.sb-b{background:#fee2e2;color:#dc0a2d}
.sb-a{background:#dcfce7;color:#15803d}
.sb-p{background:#dce8f5;color:#00234b}
.sb-d{background:#f2f2f2;color:#6b7280}
.gtg{padding:4px 10px;border-radius:100px;font-size:12px;font-weight:600;background:#dce8f5;color:#00234b}
.jtg{padding:4px 10px;border-radius:100px;font-size:12px;font-weight:600;background:#f0fdf4;color:#166534}
.panel h3{font-size:17px;font-weight:700;color:#111;margin-bottom:5px;line-height:1.4}
.plc{font-size:13px;color:#6b7280;margin-bottom:14px;line-height:1.45}
.pgr{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-bottom:12px}
.pc2{background:#f8f9fb;border-radius:10px;padding:10px 12px;border:1px solid #f0f0f0}
.pc2 .lb{font-size:12px;color:#9ca3af;margin-bottom:3px}
.pc2 .vl{font-size:14px;font-weight:600;color:#111}
.pds{font-size:13px;color:#4b5563;line-height:1.65;padding-top:12px;border-top:1px solid #f3f4f6}
.panlagen{margin-top:12px;padding-top:12px;border-top:1px solid #f3f4f6}
.panlagen-title{font-size:11px;font-weight:700;color:#9ca3af;text-transform:uppercase;letter-spacing:.06em;margin-bottom:7px}
.panlagen-list{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:4px}
.panlagen-list li{font-size:12px;color:#374151;padding:5px 9px;background:#f8f9fb;border-radius:7px;border:1px solid #f0f0f0;line-height:1.4}
.fh{font-size:12px;margin-top:7px}
.fh a{color:#00234b;text-decoration:none}
.fh a:hover{text-decoration:underline}
.plcard{margin-top:14px;border-top:1.5px solid #f0f0f0;padding-top:14px;display:flex;gap:13px;align-items:flex-start}
.plav{width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,#dce8f5,#e8f0fe);flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:700;color:#00234b;overflow:hidden;border:2.5px solid #e5e7eb}
.plav img{width:100%;height:100%;object-fit:cover;object-position:center top}
.pli{flex:1;min-width:0}
.pln{font-size:14px;font-weight:700;color:#111;margin-bottom:2px}
.plr{font-size:11px;color:#6b7280;margin-bottom:7px}
.plco{display:flex;flex-direction:column;gap:5px}
.plco a{font-size:13px;color:#00234b;text-decoration:none;display:flex;align-items:center;gap:5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.plco a:hover{text-decoration:underline}
.sbcard{margin-top:10px;border-top:1px dashed #e5e7eb;padding-top:10px;display:none;gap:13px;align-items:flex-start}
.sbav{width:36px;height:36px;border-radius:50%;background:#f0f4ff;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;color:#6b7280;border:1.5px solid #e5e7eb;overflow:hidden}
.sbav img{width:100%;height:100%;object-fit:cover;object-position:center top}
.sbli{flex:1;min-width:0}
.sbln{font-size:13px;font-weight:600;color:#111;margin-bottom:1px}
.sblr{font-size:11px;color:#9ca3af;margin-bottom:5px}
.sbco a{font-size:12px;color:#00234b;text-decoration:none;display:flex;align-items:center;gap:5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sbco a:hover{text-decoration:underline}
.ep{position:absolute;top:12px;left:12px;width:300px;background:#fff;border:1.5px solid #00234b;border-radius:16px;z-index:300;display:none;box-shadow:0 8px 28px rgba(0,35,75,.18);max-height:calc(100% - 24px);overflow-y:auto}
.ep.show{display:block}
.eh{background:#00234b;color:#fff;padding:12px 15px;display:flex;align-items:center;justify-content:space-between;border-radius:14px 14px 0 0;position:sticky;top:0;z-index:1}
.eh h4{font-size:14px;font-weight:700}
.ecl{background:rgba(255,255,255,.2);border:none;cursor:pointer;color:#fff;width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:13px;font-family:inherit}
.ecl:hover{background:rgba(255,255,255,.35)}
.eb{padding:14px}
.ehi{background:#eef2ff;border:1px solid #c7d2fe;border-radius:9px;padding:9px 11px;font-size:12px;color:#00234b;margin-bottom:12px;line-height:1.55}
.esec{font-size:11px;font-weight:700;color:#9ca3af;text-transform:uppercase;letter-spacing:.06em;margin:12px 0 7px;padding-bottom:5px;border-bottom:1px solid #f3f4f6}
.fi{margin-bottom:9px}
.fi label{display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:3px}
.fi input,.fi select{width:100%;padding:8px 10px;font-size:13px;border:1.5px solid #e5e7eb;border-radius:9px;font-family:inherit;outline:none;background:#fff;color:#111;transition:border .15s}
.fi input:focus{border-color:#00234b}
.cr{display:grid;grid-template-columns:1fr 1fr;gap:6px}
.gst{font-size:12px;color:#6b7280;margin-top:5px;text-align:center;min-height:16px}
.fpr{width:100%;height:80px;border-radius:9px;background:#f8f9fb;border:1.5px dashed #e5e7eb;display:flex;align-items:center;justify-content:center;font-size:12px;color:#9ca3af;margin-top:7px;overflow:hidden}
.fpr img{width:100%;height:80px;object-fit:cover;border-radius:7px}
.avpr{width:50px;height:50px;border-radius:50%;background:#eef2ff;border:1.5px dashed #c7d2fe;display:flex;align-items:center;justify-content:center;font-size:20px;overflow:hidden;margin-top:6px}
.avpr img{width:50px;height:50px;object-fit:cover;border-radius:50%}
.upl{display:none}
.ubtn{width:100%;margin-top:5px;padding:7px;background:#f8f9fb;border:1.5px dashed #e5e7eb;border-radius:9px;font-size:12px;color:#6b7280;cursor:pointer;font-family:inherit;text-align:center}
.ubtn:hover{background:#eef2ff;border-color:#c7d2fe;color:#00234b}
.br{display:flex;gap:7px;margin-top:12px}
.bsave{flex:1;padding:9px;background:#00234b;color:#fff;border:none;border-radius:9px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit}
.bsave:hover{background:#003b80}
.bsec{flex:1;padding:9px;background:#eef2ff;color:#00234b;border:1.5px solid #c7d2fe;border-radius:9px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit}
.bsec:hover{background:#e0e7ff}
.xbar{background:#fff;border:1.5px solid #e5e7eb;border-radius:12px;padding:10px 16px;margin-top:12px;display:none;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.xbar.show{display:flex}
.xbar span{font-size:13px;color:#374151}
.bexp{padding:7px 14px;background:#059669;color:#fff;border:none;border-radius:9px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit}
.nores{position:absolute;bottom:14px;left:50%;transform:translateX(-50%);background:#fff;border:1.5px solid #e5e7eb;border-radius:10px;padding:10px 18px;font-size:13px;color:#6b7280;z-index:100;box-shadow:0 4px 14px rgba(0,0,0,.07);display:none;white-space:nowrap}
.nores.show{display:block}


/* ── KINO-MODUS ── */
.kino-overlay{position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:2000;display:none;flex-direction:column;align-items:center;justify-content:center}
.kino-overlay.show{display:flex}
.kino-inner{width:min(1300px,98vw);height:92vh;background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 24px 64px rgba(0,0,0,.5);display:grid;grid-template-columns:1fr 480px;position:relative}
.kino-map-wrap{position:relative}
#kino-map{width:100%;height:100%}
.kino-info{padding:24px;display:flex;flex-direction:column;justify-content:space-between;overflow-y:auto;border-left:1.5px solid #f3f4f6}
.kino-tags{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}
.kino-title{font-size:22px;font-weight:700;color:#111;margin-bottom:6px;line-height:1.3}
.kino-loc{font-size:13px;color:#6b7280;margin-bottom:18px}
.kino-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:9px;margin-bottom:16px}
.kino-card{background:#f8f9fb;border-radius:10px;padding:10px 12px;border:1px solid #f0f0f0}
.kino-card .lb{font-size:11px;color:#9ca3af;margin-bottom:2px}
.kino-card .vl{font-size:14px;font-weight:600;color:#111}
.kino-desc{font-size:13px;color:#4b5563;line-height:1.65;margin-bottom:18px}
.kino-img{width:100%;height:260px;border-radius:10px;overflow:hidden;margin-bottom:14px;background:linear-gradient(135deg,#dce8f5,#e8f0fe);display:none;flex-shrink:0}
.kino-img img{width:100%;height:100%;object-fit:cover}
.kino-img.has{display:block}
.kino-people{display:flex;flex-direction:row;padding-bottom:16px;margin-top:0;margin-bottom:16px;border-bottom:1.5px solid #f0f0f0;margin-left:-24px;margin-right:-24px}
.kino-pl{display:flex;gap:12px;align-items:flex-start;width:50%;min-width:0;overflow:hidden;padding:0 24px;box-sizing:border-box}
.kino-pl+.kino-pl{border-left:1.5px solid #f0f0f0}
.kino-av{width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,#dce8f5,#e8f0fe);flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700;color:#00234b;overflow:hidden;border:2.5px solid #e5e7eb}
.kino-av img{width:100%;height:100%;object-fit:cover;object-position:center top}
.kino-av.lg{width:64px;height:64px;font-size:22px}
.kino-pln{font-size:14px;font-weight:700;color:#111;margin-bottom:2px}
.kino-plr{font-size:11px;color:#6b7280;margin-bottom:5px}
.kino-plco a{font-size:12px;color:#00234b;text-decoration:none;display:block}
/* Controls über der Kino-Karte */
.kino-top{position:absolute;top:12px;left:0;right:0;display:flex;align-items:center;justify-content:space-between;padding:0 14px;z-index:20}
.kino-close{background:rgba(255,255,255,.93);border:none;cursor:pointer;font-size:14px;width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 6px rgba(0,0,0,.2);font-family:inherit;color:#333}
.kino-close:hover{background:#fff}
.kino-nav{display:flex;gap:8px}
.kino-nb{background:rgba(255,255,255,.93);border:none;cursor:pointer;font-size:18px;width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 6px rgba(0,0,0,.2);font-family:inherit;color:#333}
.kino-nb:hover{background:#fff;color:#00234b}

/* ── CLUSTER ── */
.pin-cluster{background:#00234b;color:#fff;width:20px;height:20px;border-radius:50%;border:2px solid #fff;box-shadow:0 2px 8px rgba(0,0,0,.3);display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;cursor:pointer;position:relative}
.pin-cluster:hover{box-shadow:0 3px 10px rgba(0,0,0,.4)}
.pin-cluster::after{content:attr(data-count);position:absolute;top:-5px;right:-6px;background:#dc0a2d;color:#fff;border-radius:100px;font-size:8px;font-weight:700;padding:1px 4px;border:1.5px solid #fff;line-height:1.4}

/* Pin-Tooltip */
.pin-tooltip{position:absolute;z-index:9999;pointer-events:none;width:200px;background:#fff;border-radius:11px;box-shadow:0 4px 18px rgba(0,0,0,.18);border:1px solid #e5e7eb;overflow:hidden;opacity:0;transition:opacity .15s}
.pin-tooltip.show{opacity:1}
.pin-tooltip-img{width:100%;height:90px;object-fit:cover;object-position:center top;display:block;background:#f0f4ff}
.pin-tooltip-img-ph{width:100%;height:90px;background:linear-gradient(135deg,#dce8f5,#e8f0fe);display:flex;align-items:center;justify-content:center;font-size:11px;color:#9ca3af}
.pin-tooltip-body{padding:9px 11px}
.pin-tooltip-name{font-size:12px;font-weight:700;color:#111;line-height:1.35;margin-bottom:3px}
.pin-tooltip-sub{font-size:11px;color:#6b7280;display:flex;align-items:center;gap:4px}
.pin-tooltip-st{display:inline-block;width:7px;height:7px;border-radius:50%;flex-shrink:0}
.pin-tooltip::after{content:"";position:absolute;top:100%;left:50%;transform:translateX(-50%);border:6px solid transparent;border-top-color:#fff}
.pin-tooltip::before{content:"";position:absolute;top:100%;left:50%;transform:translateX(-50%);border:7px solid transparent;border-top-color:#e5e7eb;margin-top:1px}
.pi-cluster-badge{display:inline-flex;align-items:center;gap:3px;background:#dce8f5;color:#00234b;border-radius:100px;font-size:10px;font-weight:700;padding:1px 7px;margin-left:5px;vertical-align:middle}
.cluster-hdr{background:linear-gradient(135deg,#00234b,#1a3a6b);border-radius:14px 14px 0 0;padding:14px 18px;color:#fff}
.cluster-hdr .ch-lbl{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.09em;opacity:.7;margin-bottom:4px}
.cluster-hdr h3{font-size:16px;font-weight:700;color:#fff;line-height:1.35;margin-bottom:3px}
.cluster-hdr .ch-sub{font-size:12px;opacity:.75}
.ctabs{display:flex;gap:0;border-bottom:1.5px solid #f0f0f0;margin:0 -18px 14px;padding:0 18px;overflow-x:auto}
.ctab{padding:9px 12px;font-size:12px;font-weight:600;color:#9ca3af;cursor:pointer;border-bottom:2px solid transparent;white-space:nowrap;transition:all .15s;margin-bottom:-1.5px;flex-shrink:0;user-select:none}
.ctab.act{color:#00234b;border-bottom-color:#00234b}
.ctab:hover:not(.act){color:#374151}
.ctab-pane{display:none}
.ctab-pane.act{display:block}
.call-lbl{font-size:11px;font-weight:700;color:#9ca3af;text-transform:uppercase;letter-spacing:.06em;margin-bottom:9px;display:flex;align-items:center;gap:6px}
.call-badge{background:#00234b;color:#fff;border-radius:100px;font-size:9px;padding:1px 6px;font-weight:700}
.call-proj-sep{font-weight:700;color:#00234b;background:#dce8f5;border-color:#c7d2fe}

.kino-list{background:#f8f9fb;border-left:1.5px solid #e5e7eb;display:flex;flex-direction:column;overflow:hidden}
.kino-list-head{padding:14px 16px 10px;border-bottom:1px solid #e5e7eb;flex-shrink:0}
